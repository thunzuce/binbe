local function positionLineBetween(lineFrame, a, b, thickness, color)
	local delta = b - a
	local length = delta.Magnitude
	if length < 1 then
		lineFrame.Visible = false
		return
	end
	local mid = (a + b) * 0.5
	local angleDeg = math.deg(math.atan2(delta.Y, delta.X))
	lineFrame.Position = UDim2.fromOffset(mid.X, mid.Y)
	lineFrame.Size = UDim2.fromOffset(length, thickness or 1.4)
	lineFrame.Rotation = angleDeg
	lineFrame.BackgroundColor3 = color
	lineFrame.Visible = true
end

local function hideEntryBones(entry)
	for _, bone in ipairs(entry.bonePool) do
		bone.Visible = false
	end
end

function EspController:ensureEntry(targetPlayer)
	if not targetPlayer or targetPlayer == player then
		return nil
	end
	if self.entries[targetPlayer] then
		return self.entries[targetPlayer]
	end
	if not self.layer or not self.layer.Parent then
		return nil
	end
	local entry = createEspEntry(targetPlayer)
	self.entries[targetPlayer] = entry
	return entry
end

function EspController:removeEntry(targetPlayer)
	local entry = self.entries[targetPlayer]
	if entry then
		if entry.holder and entry.holder.Parent then
			entry.holder:Destroy()
		end
		self.entries[targetPlayer] = nil
	end
end

function EspController:hideAll()
	self.activeCount = 0
	for _, entry in pairs(self.entries) do
		entry.holder.Visible = false
	end
end

function EspController:isTeammate(targetPlayer)
	if not State.espTeamCheck then
		return false
	end
	if player.Team and targetPlayer.Team and player.Team == targetPlayer.Team then
		return true
	end
	if player.TeamColor and targetPlayer.TeamColor and player.TeamColor == targetPlayer.TeamColor then
		if player.Neutral == false and targetPlayer.Neutral == false then
			return true
		end
	end
	return false
end

function EspController:step(cam)
	if not State.espEnabled or not self.layer or not self.layer.Parent or not cam then
		self:hideAll()
		return
	end

	local viewport = cam.ViewportSize
	if viewport.X <= 4 or viewport.Y <= 4 then
		self:hideAll()
		return
	end

	local active = 0
	local accentColor = getAccent().accent
	local originPos = cam.CFrame.Position
	local bottomCenter = Vector2.new(viewport.X * 0.5, viewport.Y * 0.96)

	for _, other in ipairs(Players:GetPlayers()) do
		if other ~= player then
			local entry = self:ensureEntry(other)
			local char = other.Character
			local hum = char and char:FindFirstChildOfClass("Humanoid")
			local rootPart = char and (findFirstPart(char, { "HumanoidRootPart", "UpperTorso", "Torso" }) or char.PrimaryPart)

			if entry and char and hum and hum.Health > 0 and rootPart and not self:isTeammate(other) then
				local dist = (rootPart.Position - originPos).Magnitude
				local rootScreen, onScreen = cam:WorldToViewportPoint(rootPart.Position)

				if dist <= State.espMaxDistance and onScreen and rootScreen.Z > 0 then
					local headPart = findFirstPart(char, { "Head" })
					local topWorld = headPart and (headPart.Position + Vector3.new(0, headPart.Size.Y * 0.65, 0))
						or (rootPart.Position + Vector3.new(0, 2.3, 0))
					local bottomWorld = rootPart.Position - Vector3.new(0, 3.0, 0)

					local topScreen = cam:WorldToViewportPoint(topWorld)
					local bottomScreen = cam:WorldToViewportPoint(bottomWorld)

					local boxHeight = math.clamp(math.abs(bottomScreen.Y - topScreen.Y), 16, viewport.Y * 0.9)
					local boxWidth = math.clamp(boxHeight * 0.58, 12, viewport.X * 0.6)
					local centerX = rootScreen.X
					local topY = math.min(topScreen.Y, bottomScreen.Y)
					local leftX = centerX - boxWidth * 0.5

					local isLocked = (AimController.currentModel == char)
					local color = isLocked and BASE_COLORS.locked or accentColor

					entry.holder.Visible = true
					active += 1

					if State.espBox then
						entry.boxFrame.Position = UDim2.fromOffset(leftX, topY)
						entry.boxFrame.Size = UDim2.fromOffset(boxWidth, boxHeight)
						entry.boxStroke.Color = color
						entry.boxFrame.Visible = true
					else
						entry.boxFrame.Visible = false
					end

					if State.espHealth then
						local maxHp = math.max(hum.MaxHealth, 1)
						local ratio = math.clamp(hum.Health / maxHp, 0, 1)
						entry.hpBack.Position = UDim2.fromOffset(leftX - 6, topY)
						entry.hpBack.Size = UDim2.fromOffset(3, boxHeight)
						entry.hpFill.Size = UDim2.fromScale(1, ratio)
						entry.hpFill.BackgroundColor3 = Color3.fromRGB(235, 95, 95):Lerp(BASE_COLORS.on, ratio)
						entry.hpBack.Visible = true
					else
						entry.hpBack.Visible = false
					end

					if State.espName then
						entry.infoLabel.Text = string.format(
							"%s  •  %dm",
							other.DisplayName,
							math.floor(dist + 0.5)
						)
						entry.infoLabel.Position = UDim2.fromOffset(centerX, topY - 4)
						entry.infoLabel.TextColor3 = color
						entry.infoLabel.Visible = true
					else
						entry.infoLabel.Visible = false
					end

					if State.espTracer then
						local targetPt = Vector2.new(centerX, topY + boxHeight)
						positionLineBetween(entry.tracerLine, bottomCenter, targetPt, 1.3, color)
					else
						entry.tracerLine.Visible = false
					end

					if State.espSkeleton then
						local pairsList = (hum.RigType == Enum.HumanoidRigType.R6) and R6_PAIRS or R15_PAIRS
						local boneIdx = 0
						for _, pair in ipairs(pairsList) do
							local partA = char:FindFirstChild(pair[1])
							local partB = char:FindFirstChild(pair[2])
							if partA and partA:IsA("BasePart") and partB and partB:IsA("BasePart") then
								local pA, visA = cam:WorldToViewportPoint(partA.Position)
								local pB, visB = cam:WorldToViewportPoint(partB.Position)
								if visA and visB and pA.Z > 0 and pB.Z > 0 then
									boneIdx += 1
									local boneFrame = entry.bonePool[boneIdx]
									if boneFrame then
										positionLineBetween(
											boneFrame,
											Vector2.new(pA.X, pA.Y),
											Vector2.new(pB.X, pB.Y),
											1.2,
											color
										)
									end
								end
							end
						end
						for i = boneIdx + 1, #entry.bonePool do
							entry.bonePool[i].Visible = false
						end
					else
						hideEntryBones(entry)
					end
				else
					entry.holder.Visible = false
				end
			elseif entry then
				entry.holder.Visible = false
			end
		end
	end

	self.activeCount = active
end

