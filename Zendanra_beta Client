local function clampRootToViewport()
	local camera = workspace.CurrentCamera
	if not camera then return end
	local viewport = camera.ViewportSize
	if viewport.X <= 0 or viewport.Y <= 0 then return end

	local halfW = (BASE_WIDTH * rootScale.Scale) * 0.5
	local halfH = (getTargetHeight() * rootScale.Scale) * 0.5
	local margin = 8

	local absPos = root.AbsolutePosition
	local absSize = root.AbsoluteSize
	local centerX = absPos.X + absSize.X * 0.5
	local centerY = absPos.Y + absSize.Y * 0.5

	local clampedX = math.clamp(centerX, halfW + margin, math.max(halfW + margin, viewport.X - halfW - margin))
	local clampedY = math.clamp(centerY, halfH + margin, math.max(halfH + margin, viewport.Y - halfH - margin))

	if math.abs(clampedX - centerX) > 1 or math.abs(clampedY - centerY) > 1 then
		root.Position = UDim2.fromOffset(clampedX, clampedY)
	end
end

applyResponsiveLayout = function()
	local camera = workspace.CurrentCamera
	if not camera then return end
	local viewport = camera.ViewportSize
	if viewport.X <= 0 or viewport.Y <= 0 then return end

	local maxWidth = viewport.X * 0.94
	local maxHeight = viewport.Y * 0.88
	local fitScale = math.min(maxWidth / BASE_WIDTH, maxHeight / getTargetHeight(), 1)
	local effectiveScale = math.min(State.uiScale, fitScale)
	rootScale.Scale = effectiveScale

	if not State.hasCustomPosition then
		root.Position = UDim2.fromScale(0.5, 0.5)
	else
		clampRootToViewport()
	end

	screenMetric.Text = string.format(
		"%dx%d  (%d%%)",
		math.floor(viewport.X),
		math.floor(viewport.Y),
		math.floor(effectiveScale * 100 + 0.5)
	)
end

local function applyScale(value, shouldSave)
	State.uiScale = math.clamp(value, 0.82, 1.12)
	local alpha = (State.uiScale - 0.82) / (1.12 - 0.82)
	scaleFill.Size = UDim2.fromScale(alpha, 1)
	scaleKnob.Position = UDim2.fromScale(alpha, 0.5)
	scaleTitle.Text = tr("scale") .. "  •  " .. tostring(math.floor(State.uiScale * 100 + 0.5)) .. "%"
	applyResponsiveLayout()
	if shouldSave then
		savePersistedState()
	end
end

local function bindInteractions()
	for name, _ in pairs(themeButtons) do
		local swatch = themeCard:GetChildren()[table.find(themeOrder, name) + 1]
		if swatch and swatch:IsA("TextButton") then
			ResourceManager:connect(swatch.Activated, function()
				State.theme = name
				savePersistedState()
				broadcastTheme()
				notify(tr("themeChanged"))
			end, "Theme_" .. name)
		end
	end

	local draggingScale = false
	local function updateScaleFromInput(input)
		if scaleTrack.AbsoluteSize.X <= 0 then return end
		local ratio = math.clamp(
			(input.Position.X - scaleTrack.AbsolutePosition.X) / scaleTrack.AbsoluteSize.X,
			0, 1
		)
		applyScale(0.82 + ratio * (1.12 - 0.82), false)
	end

	ResourceManager:connect(scaleHitbox.InputBegan, function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			draggingScale = true
			updateScaleFromInput(input)
		end
	end, "ScaleInputBegan")

	ResourceManager:connect(UserInputService.InputChanged, function(input)
		if draggingScale and (
			input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch
		) then
			updateScaleFromInput(input)
		end
	end, "ScaleInputChanged")

	ResourceManager:connect(UserInputService.InputEnded, function(input)
		if draggingScale and (
			input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch
		) then
			draggingScale = false
			savePersistedState()
		end
	end, "ScaleInputEnded")

	ResourceManager:connect(UserInputService.InputBegan, function(input, gameProcessed)
		LogicController:handleInputBegan(input, gameProcessed)
	end, "LogicControllerInputBegan")

	local function toggleLanguage()
		State.language = (State.language == "VI") and "EN" or "VI"
		savePersistedState()
		broadcastLanguage()
		notify(tr("saved"))
	end

	ResourceManager:connect(quickLangBtn.Activated, toggleLanguage, "QuickLang")
	ResourceManager:connect(langButton.Activated, toggleLanguage, "SettingsLang")
	ResourceManager:connect(quickDiagBtn.Activated, function()
		showTab("Diagnostics")
	end, "QuickDiag")

	ResourceManager:connect(resetButton.Activated, function()
		State.theme = "Emerald"
		State.language = "VI"
		State.animations = true
		State.compact = false
		State.hasCustomPosition = false
		applyScale(1.0, false)
		savePersistedState()
		broadcastTheme()
		broadcastLanguage()
		syncAnimToggle()
		syncCompactToggle()
		playTween(root, 0.2, {
			Size = UDim2.fromOffset(BASE_WIDTH, getTargetHeight()),
			Position = UDim2.fromScale(0.5, 0.5),
		})
		notify(tr("resetDone"))
	end, "ResetDefault")

	local draggingWindow = false
	local dragStartPos
	local windowStartPos

	ResourceManager:connect(header.InputBegan, function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			draggingWindow = true
			dragStartPos = input.Position
			windowStartPos = root.Position
		end
	end, "DragStart")

	ResourceManager:connect(UserInputService.InputChanged, function(input)
		if draggingWindow and (
			input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch
		) then
			local delta = input.Position - dragStartPos
			State.hasCustomPosition = true
			root.Position = UDim2.new(
				windowStartPos.X.Scale,
				windowStartPos.X.Offset + delta.X,
				windowStartPos.Y.Scale,
				windowStartPos.Y.Offset + delta.Y
			)
		end
	end, "DragMove")

	ResourceManager:connect(UserInputService.InputEnded, function(input)
		if draggingWindow and (
			input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch
		) then
			draggingWindow = false
			clampRootToViewport()
		end
	end, "DragEnd")

	ResourceManager:connect(collapseButton.Activated, function()
		State.collapsed = not State.collapsed
		body.Visible = not State.collapsed
		divider.Visible = not State.collapsed
		collapseButton.Text = State.collapsed and "+" or "—"
		playTween(root, 0.2, { Size = UDim2.fromOffset(BASE_WIDTH, getTargetHeight()) })
		clampRootToViewport()
	end, "CollapseToggle")

	ResourceManager:connect(closeButton.Activated, function()
		ResourceManager:cleanup()
		gui:Destroy()
	end, "CloseGui")

	local function refreshPlayers()
		playerCountValue.Text = tostring(#Players:GetPlayers())
	end
	ResourceManager:connect(Players.PlayerAdded, refreshPlayers, "PlayerAdded")
	ResourceManager:connect(Players.PlayerRemoving, refreshPlayers, "PlayerRemoving")

	local function updateCharacterRig(character)
		if not character then
			rigMetric.Text = "No Character"
			return
		end
		local humanoid = character:FindFirstChildOfClass("Humanoid") or character:WaitForChild("Humanoid", 3)
		if humanoid then
			local pairsList = LogicController:getRigPairs(character)
			local jointCount = pairsList and #pairsList or 0
			rigMetric.Text = string.format("%s (%d)", humanoid.RigType.Name, jointCount)
		else
			rigMetric.Text = "Unknown"
		end
	end
	updateCharacterRig(player.Character)
	ResourceManager:connect(player.CharacterAdded, updateCharacterRig, "CharacterAdded")

	local cameraViewportConn
	local function bindCurrentCamera()
		if cameraViewportConn and cameraViewportConn.Connected then
			cameraViewportConn:Disconnect()
		end
		local cam = workspace.CurrentCamera
		if cam then
			cameraViewportConn = ResourceManager:connect(
				cam:GetPropertyChangedSignal("ViewportSize"),
				applyResponsiveLayout,
				"ViewportSizeChanged"
			)
		end
		applyResponsiveLayout()
	end
	bindCurrentCamera()
	ResourceManager:connect(workspace:GetPropertyChangedSignal("CurrentCamera"), bindCurrentCamera, "CameraChanged")

	LogicController:bind(function(dt, controller)
		if not ResourceManager.alive then return end
		local hasValidSubject = controller.activeSubject ~= nil
		controller:updateSubjectState(dt, hasValidSubject)
		for _, updater in ipairs(ResourceManager.updaters) do
			updater(dt, controller)
		end
	end)

	local frameCount = 0
	local elapsed = 0
	ResourceManager:connect(RunService.RenderStepped, function(dt)
		frameCount += 1
		elapsed += dt
		if elapsed >= 0.5 then
			local fps = math.floor((frameCount / elapsed) + 0.5)
			fpsMetric.Text = tostring(fps) .. " FPS"

			local pingMs = 0
			pcall(function()
				pingMs = math.floor(Stats.Network.ServerStatsItem["Data Ping"]:GetValue() + 0.5)
			end)
			pingMetric.Text = tostring(pingMs) .. " ms"

			frameCount = 0
			elapsed = 0
		end
	end, "DiagnosticsLoop")
end

