	end, "CollapseToggle")

	ResourceManager:connect(closeButton.Activated, function()
		ResourceManager:cleanup()
		gui:Destroy()
	end, "CloseGui")

	local function refreshPlayers()
		playerCountValue.Text = tostring(#Players:GetPlayers())
		if targetListFrame.Visible then
			rebuildTargetOptions(nil)
		end
	end
	ResourceManager:connect(Players.PlayerAdded, function(joined)
		EspController:ensureEntry(joined)
		refreshPlayers()
	end, "PlayerAdded")
	ResourceManager:connect(Players.PlayerRemoving, function(leaving)
		EspController:removeEntry(leaving)
		if State.targetPlayer == leaving then
			State.targetPlayer = nil
			AimController:resetTracking()
			syncTargetButtonText()
		end
		playerCountValue.Text = tostring(#Players:GetPlayers())
		rebuildTargetOptions(leaving)
	end, "PlayerRemoving")

	for _, other in ipairs(Players:GetPlayers()) do
		if other ~= player then
			EspController:ensureEntry(other)
		end
	end

	local function updateCharacterRig(character)
		if not character then
			rigMetric.Text = "No Character"
			return
		end
		local humanoid = character:FindFirstChildOfClass("Humanoid") or character:WaitForChild("Humanoid", 3)
		if humanoid then
			local rigPairs = (humanoid.RigType == Enum.HumanoidRigType.R6) and R6_PAIRS or R15_PAIRS
			rigMetric.Text = string.format("%s (%d)", humanoid.RigType.Name, #rigPairs)
		else
			rigMetric.Text = "Unknown"
		end
	end
	updateCharacterRig(player.Character)
	ResourceManager:connect(player.CharacterAdded, updateCharacterRig, "CharacterAdded")

	local cameraViewportConn
	local function bindCurrentCamera()
		if cameraViewportConn and cameraViewportConn.Connected then
			cameraViewportConn:Disconnect()
		end
		local cam = getCamera()
		if cam then
			cameraViewportConn = ResourceManager:connect(
				cam:GetPropertyChangedSignal("ViewportSize"),
				applyResponsiveLayout,
				"ViewportSizeChanged"
			)
		end
		applyResponsiveLayout()
	end
	bindCurrentCamera()
	ResourceManager:connect(workspace:GetPropertyChangedSignal("CurrentCamera"), bindCurrentCamera, "CameraChanged")

	pcall(function()
		RunService:UnbindFromRenderStep("ZendanraAimStep")
	end)

	local frameCount = 0
	local elapsed = 0
	local lastLockedState = false
	local lastEspText = ""

	pcall(function()
		RunService:BindToRenderStep("ZendanraAimStep", Enum.RenderPriority.Camera.Value + 5, function(dt)
			if not ResourceManager.alive then return end

			frameCount += 1
			elapsed += dt
			if elapsed >= 0.5 then
				local fps = math.floor((frameCount / elapsed) + 0.5)
				fpsMetric.Text = tostring(fps) .. " FPS"

				local pingMs = 0
				pcall(function()
					pingMs = math.floor(Stats.Network.ServerStatsItem["Data Ping"]:GetValue() + 0.5)
				end)
				pingMetric.Text = tostring(pingMs) .. " ms"

				frameCount = 0
				elapsed = 0
			end

			local cam = getCamera()
			if cam then
				safeCall("AimStep", function()
					local locked = AimController:step(dt, cam, fovCircle, fovCircleStroke)
					if locked ~= lastLockedState then
						lastLockedState = locked
						aimStatusValue.Text = locked and tr("aimLocking") or tr("aimIdle")
						aimStatusValue.TextColor3 = locked and BASE_COLORS.locked or getAccent().accent
					end
				end)

				safeCall("EspStep", function()
					EspController:step(cam)
					refreshDashboardEspStatus()
					if espStatusValue.Text ~= lastEspText then
						lastEspText = espStatusValue.Text
						espStatusValue.TextColor3 = State.espEnabled and getAccent().accent or BASE_COLORS.muted
					end
				end)
			end
		end)
	end)
end

