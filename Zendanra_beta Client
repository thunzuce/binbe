local ResourceManager = {
	alive = true,
	connections = {},
	tweens = {},
	updaters = {},
}

function ResourceManager:connect(signal, callback, context)
	if not self.alive or not signal then return nil end
	local conn = signal:Connect(function(...)
		if self.alive then
			safeCall(context or "Signal", callback, ...)
		end
	end)
	table.insert(self.connections, conn)
	return conn
end

function ResourceManager:trackTween(tweenObj)
	if not tweenObj then return nil end
	self.tweens[tweenObj] = true
	tweenObj.Completed:Once(function()
		self.tweens[tweenObj] = nil
	end)
	return tweenObj
end

function ResourceManager:cleanup()
	if not self.alive then return end
	self.alive = false

	pcall(function()
		RunService:UnbindFromRenderStep("ZendanraAimStep")
	end)

	for _, conn in ipairs(self.connections) do
		if conn and conn.Connected then
			conn:Disconnect()
		end
	end
	table.clear(self.connections)

	for tweenObj in pairs(self.tweens) do
		pcall(function()
			tweenObj:Cancel()
		end)
		self.tweens[tweenObj] = nil
	end

	table.clear(self.updaters)
end

local function playTween(object, duration, properties)
	if not object or not object.Parent then
		return nil
	end
	if not State.animations or duration <= 0 then
		for key, value in pairs(properties) do
			pcall(function()
				object[key] = value
			end)
		end
		return nil
	end
	local info = TweenInfo.new(duration, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
	local animation = TweenService:Create(object, info, properties)
	ResourceManager:trackTween(animation)
	animation:Play()
	return animation
end

local function make(className, properties, parent)
	local object = Instance.new(className)
	for key, value in pairs(properties or {}) do
		object[key] = value
	end
	object.Parent = parent
	return object
end

local function addCorner(parent, radius)
	return make("UICorner", { CornerRadius = UDim.new(0, radius or 10) }, parent)
end

local function addStroke(parent, color, thickness, transparency)
	return make("UIStroke", {
		Color = color or BASE_COLORS.stroke,
		Thickness = thickness or 1,
		Transparency = transparency or 0,
	}, parent)
end

