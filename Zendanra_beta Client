local function isPointInsideGui(pos)
	if not gui or not gui.Parent or not root or not root.Visible then
		return false
	end
	local p = Vector2.new(pos.X, pos.Y)
	local topLeft = root.AbsolutePosition
	local bottomRight = topLeft + root.AbsoluteSize
	if p.X >= topLeft.X and p.X <= bottomRight.X and p.Y >= topLeft.Y and p.Y <= bottomRight.Y then
		return true
	end
	if targetListFrame.Visible then
		local lTop = targetListFrame.AbsolutePosition
		local lBot = lTop + targetListFrame.AbsoluteSize
		if p.X >= lTop.X and p.X <= lBot.X and p.Y >= lTop.Y and p.Y <= lBot.Y then
			return true
		end
	end
	return false
end

AimController.isInsideGuiFn = isPointInsideGui

local function clampRootToViewport()
	local camera = getCamera()
	if not camera then return end
	local viewport = camera.ViewportSize
	if viewport.X <= 0 or viewport.Y <= 0 then return end

	local halfW = (BASE_WIDTH * rootScale.Scale) * 0.5
	local halfH = (getTargetHeight() * rootScale.Scale) * 0.5
	local margin = 8

	local absPos = root.AbsolutePosition
	local absSize = root.AbsoluteSize
	local centerX = absPos.X + absSize.X * 0.5
	local centerY = absPos.Y + absSize.Y * 0.5

	local clampedX = math.clamp(centerX, halfW + margin, math.max(halfW + margin, viewport.X - halfW - margin))
	local clampedY = math.clamp(centerY, halfH + margin, math.max(halfH + margin, viewport.Y - halfH - margin))

	if math.abs(clampedX - centerX) > 1 or math.abs(clampedY - centerY) > 1 then
		root.Position = UDim2.fromOffset(clampedX, clampedY)
	end
end

applyResponsiveLayout = function()
	local camera = getCamera()
	if not camera then return end
	local viewport = camera.ViewportSize
	if viewport.X <= 0 or viewport.Y <= 0 then return end

	local maxWidth = viewport.X * 0.94
	local maxHeight = viewport.Y * 0.88
	local fitScale = math.min(maxWidth / BASE_WIDTH, maxHeight / getTargetHeight(), 1)
	local effectiveScale = math.min(State.uiScale, fitScale)
	rootScale.Scale = effectiveScale

	if not State.hasCustomPosition then
		root.Position = UDim2.fromScale(0.5, 0.5)
	else
		clampRootToViewport()
	end

	screenMetric.Text = string.format(
		"%dx%d  (%d%%)",
		math.floor(viewport.X),
		math.floor(viewport.Y),
		math.floor(effectiveScale * 100 + 0.5)
	)
end

local function applyScale(value, shouldSave)
	State.uiScale = math.clamp(value, 0.82, 1.12)
	local alpha = (State.uiScale - 0.82) / (1.12 - 0.82)
	scaleFill.Size = UDim2.fromScale(alpha, 1)
	scaleKnob.Position = UDim2.fromScale(alpha, 0.5)
	scaleTitle.Text = tr("scale") .. "  •  " .. tostring(math.floor(State.uiScale * 100 + 0.5)) .. "%"
	applyResponsiveLayout()
	if shouldSave then
		savePersistedState()
	end
end

local function bindInteractions()
	for name, swatch in pairs(themeSwatchButtons) do
		if swatch and swatch:IsA("TextButton") then
			ResourceManager:connect(swatch.Activated, function()
				State.theme = name
				savePersistedState()
				broadcastTheme()
				notify(tr("themeChanged"))
			end, "Theme_" .. name)
		end
	end

	local draggingScale = false
	local function updateScaleFromInput(input)
		if scaleTrack.AbsoluteSize.X <= 0 then return end
		local ratio = math.clamp(
			(input.Position.X - scaleTrack.AbsolutePosition.X) / scaleTrack.AbsoluteSize.X,
			0, 1
		)
		applyScale(0.82 + ratio * (1.12 - 0.82), false)
	end

	ResourceManager:connect(scaleHitbox.InputBegan, function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			draggingScale = true
			updateScaleFromInput(input)
		end
	end, "ScaleInputBegan")

	local draggingAimFov = false
	local function updateAimFovFromInput(input)
		if aimFovTrack.AbsoluteSize.X <= 0 then return end
		local ratio = math.clamp(
			(input.Position.X - aimFovTrack.AbsolutePosition.X) / aimFovTrack.AbsoluteSize.X,
			0, 1
		)
		applyFovValue(AIM_CONSTANTS.fovMin + ratio * (AIM_CONSTANTS.fovMax - AIM_CONSTANTS.fovMin), false)
	end

	ResourceManager:connect(aimFovHitbox.InputBegan, function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			draggingAimFov = true
			updateAimFovFromInput(input)
		end
	end, "AimFovBegan")

	local draggingAimSmooth = false
	local function updateAimSmoothFromInput(input)
		if aimSmoothTrack.AbsoluteSize.X <= 0 then return end
		local ratio = math.clamp(
			(input.Position.X - aimSmoothTrack.AbsolutePosition.X) / aimSmoothTrack.AbsoluteSize.X,
			0, 1
		)
		applySmoothValue(AIM_CONSTANTS.smoothMin + ratio * (AIM_CONSTANTS.smoothMax - AIM_CONSTANTS.smoothMin), false)
	end

	ResourceManager:connect(aimSmoothHitbox.InputBegan, function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			draggingAimSmooth = true
			updateAimSmoothFromInput(input)
		end
	end, "AimSmoothBegan")

	local draggingEspDist = false
	local function updateEspDistFromInput(input)
		if espDistTrack.AbsoluteSize.X <= 0 then return end
		local ratio = math.clamp(
			(input.Position.X - espDistTrack.AbsolutePosition.X) / espDistTrack.AbsoluteSize.X,
			0, 1
		)
		applyEspDistValue(ESP_CONSTANTS.distMin + ratio * (ESP_CONSTANTS.distMax - ESP_CONSTANTS.distMin), false)
	end

	ResourceManager:connect(espDistHitbox.InputBegan, function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			draggingEspDist = true
			updateEspDistFromInput(input)
		end
	end, "EspDistBegan")

	local draggingWindow = false
	local dragStartPos
	local windowStartPos

	ResourceManager:connect(header.InputBegan, function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			draggingWindow = true
			dragStartPos = input.Position
			windowStartPos = root.Position
		end
	end, "DragStart")

	ResourceManager:connect(UserInputService.InputChanged, function(input)
		local isMove = input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch
		if not isMove then return end

		if draggingScale then
			updateScaleFromInput(input)
		end
		if draggingAimFov then
			updateAimFovFromInput(input)
		end
		if draggingAimSmooth then
			updateAimSmoothFromInput(input)
		end
		if draggingEspDist then
			updateEspDistFromInput(input)
		end
		if draggingWindow then
			local scaleFactor = math.max(rootScale.Scale, 0.01)
			local delta = (input.Position - dragStartPos) / scaleFactor
			State.hasCustomPosition = true
			root.Position = UDim2.new(
				windowStartPos.X.Scale,
				windowStartPos.X.Offset + delta.X,
				windowStartPos.Y.Scale,
				windowStartPos.Y.Offset + delta.Y
			)
		end
	end, "GlobalInputChanged")

	ResourceManager:connect(UserInputService.InputBegan, function(input, gameProcessed)
		if input.KeyCode == Enum.KeyCode.F4 and not gameProcessed then
			AimController:resetTracking()
		end
		AimController:handleInputBegan(input, gameProcessed)
	end, "GlobalInputBegan")

	ResourceManager:connect(UserInputService.InputEnded, function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			if draggingScale then
				draggingScale = false
				savePersistedState()
			end
			if draggingAimFov then
				draggingAimFov = false
				savePersistedState()
			end
			if draggingAimSmooth then
				draggingAimSmooth = false
				savePersistedState()
			end
			if draggingEspDist then
				draggingEspDist = false
				savePersistedState()
			end
			if draggingWindow then
				draggingWindow = false
				clampRootToViewport()
			end
		end
		AimController:handleInputEnded(input)
	end, "GlobalInputEnded")

