local function rebuildTargetOptions(excludedPlayer)
	for _, child in ipairs(targetListFrame:GetChildren()) do
		if child:IsA("TextButton") then
			child:Destroy()
		end
	end

	local options = { { label = tr("targetAll"), plr = nil } }
	for _, other in ipairs(Players:GetPlayers()) do
		if other ~= player and other ~= excludedPlayer then
			table.insert(options, {
				label = other.DisplayName .. " (@" .. other.Name .. ")",
				plr = other,
			})
		end
	end

	for idx, opt in ipairs(options) do
		local isSelected = (State.targetPlayer == opt.plr)
		local itemBtn = make("TextButton", {
			LayoutOrder = idx,
			Size = UDim2.new(1, 0, 0, 24),
			BackgroundColor3 = isSelected and getAccent().accentDark or BASE_COLORS.surface3,
			Text = opt.label,
			Font = Enum.Font.GothamSemibold,
			TextSize = 10,
			TextColor3 = BASE_COLORS.text,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextTruncate = Enum.TextTruncate.AtEnd,
			AutoButtonColor = false,
			ZIndex = 21,
		}, targetListFrame)
		addCorner(itemBtn, 6)
		make("UIPadding", { PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8) }, itemBtn)

		ResourceManager:connect(itemBtn.Activated, function()
			State.targetPlayer = opt.plr
			AimController:resetTracking()
			syncTargetButtonText()
			targetListFrame.Visible = false
			aimTargetCard.Size = UDim2.new(1, 0, 0, 88)
		end, "TargetOpt_" .. tostring(idx))
	end
end

