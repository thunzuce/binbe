local function loadPersistedState()
	local savedLang = player:GetAttribute("Zendanra_Lang")
	if savedLang and LOCALE[savedLang] then
		State.language = savedLang
	end

	local savedTheme = player:GetAttribute("Zendanra_Theme")
	if savedTheme and THEMES[savedTheme] then
		State.theme = savedTheme
	end

	local savedScale = player:GetAttribute("Zendanra_Scale")
	if typeof(savedScale) == "number" then
		State.uiScale = math.clamp(savedScale, 0.82, 1.12)
	end

	local savedAnim = player:GetAttribute("Zendanra_Anim")
	if typeof(savedAnim) == "boolean" then
		State.animations = savedAnim
	end

	local savedCompact = player:GetAttribute("Zendanra_Compact")
	if typeof(savedCompact) == "boolean" then
		State.compact = savedCompact
	end
end

local function savePersistedState()
	player:SetAttribute("Zendanra_Lang", State.language)
	player:SetAttribute("Zendanra_Theme", State.theme)
	player:SetAttribute("Zendanra_Scale", State.uiScale)
	player:SetAttribute("Zendanra_Anim", State.animations)
	player:SetAttribute("Zendanra_Compact", State.compact)
end

