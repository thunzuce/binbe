local function createToggle(parent, labelKey, getInitial, onChanged, order)
	local row = createCard(parent, 48, order)
	local label = make("TextLabel", {
		Position = UDim2.fromOffset(12, 0),
		Size = UDim2.new(1, -85, 1, 0),
		BackgroundTransparency = 1,
		Text = tr(labelKey),
		Font = Enum.Font.GothamMedium,
		TextSize = 11,
		TextColor3 = BASE_COLORS.text,
		TextXAlignment = Enum.TextXAlignment.Left,
	}, row)

	local button = make("TextButton", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -10, 0.5, 0),
		Size = UDim2.fromOffset(54, 26),
		BackgroundColor3 = getInitial() and getAccent().accentDark or BASE_COLORS.surface3,
		Text = getInitial() and tr("on") or tr("off"),
		Font = Enum.Font.GothamBold,
		TextSize = 9,
		TextColor3 = BASE_COLORS.text,
		AutoButtonColor = false,
	}, row)
	addCorner(button, 8)

	local function syncVisual()
		local active = getInitial()
		button.Text = active and tr("on") or tr("off")
		playTween(button, 0.16, {
			BackgroundColor3 = active and getAccent().accentDark or BASE_COLORS.surface3
		})
	end

	ResourceManager:connect(button.Activated, function()
		onChanged(not getInitial())
		syncVisual()
	end, "Toggle_" .. labelKey)

	onThemeChange(syncVisual)
	onLanguageChange(function()
		label.Text = tr(labelKey)
		syncVisual()
	end)

	return syncVisual
end

