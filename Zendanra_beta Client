local AimController = {
	currentModel = nil,
	lastAimPos = nil,
	lastRawPos = nil,
	lastVelEstimate = Vector3.zero,
	invalidSince = nil,
	firingByAttack = false,
	fireTouchObject = nil,
	isInsideGuiFn = nil,
	playerGui = nil,
	gui = nil,
}

local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude
rayParams.IgnoreWater = true

local function findFirstPart(model, names)
	if not model then return nil end
	for _, name in ipairs(names) do
		local part = model:FindFirstChild(name)
		if part and part:IsA("BasePart") then
			return part
		end
	end
	return nil
end

local REGION_RESOLVERS = {
	Head = function(model)
		return findFirstPart(model, { "Head" })
	end,
	Neck = function(model)
		return findFirstPart(model, { "Head" })
	end,
	Body = function(model)
		return findFirstPart(model, { "UpperTorso", "Torso", "HumanoidRootPart" })
	end,
	Legs = function(model)
		return findFirstPart(model, { "RightUpperLeg", "LeftUpperLeg", "Right Leg", "Left Leg" })
	end,
}

function AimController:resetTracking()
	self.currentModel = nil
	self.lastAimPos = nil
	self.lastRawPos = nil
	self.lastVelEstimate = Vector3.zero
	self.invalidSince = nil
end

function AimController:getAimPartAndPos(model)
	if not model or not model.Parent then
		return nil, nil
	end
	local resolver = REGION_RESOLVERS[State.region]
	local part = resolver and resolver(model)
	if not part then
		part = findFirstPart(model, { "Head", "HumanoidRootPart", "Torso", "UpperTorso" })
			or model.PrimaryPart
			or model:FindFirstChildWhichIsA("BasePart")
	end
	if not part then
		return nil, nil
	end

	local pos = part.Position
	if State.region == "Neck" and part.Name == "Head" then
		pos = pos - part.CFrame.UpVector * (part.Size.Y * 0.5)
	end
	return part, pos
end

function AimController:isAlive(model)
	if not model then return false end
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	return humanoid ~= nil and humanoid.Health > 0
end

function AimController:getPlayerFromModel(model)
	if not model then return nil end
	local plr = Players:GetPlayerFromCharacter(model)
	if plr and plr ~= player then
		return plr
	end
	return nil
end

function AimController:getCandidates()
	local list = {}
	local chosen = State.targetPlayer
	if chosen then
		if chosen.Parent and chosen ~= player and chosen.Character and chosen.Character.Parent then
			table.insert(list, chosen.Character)
		end
		return list
	end

	for _, other in ipairs(Players:GetPlayers()) do
		if other ~= player and other.Character and other.Character.Parent then
			table.insert(list, other.Character)
		end
	end
	return list
end

function AimController:getAngleAndDistance(position, cam)
	local camCF = cam.CFrame
	local offset = position - camCF.Position
	local distance = offset.Magnitude
	if distance < 0.001 then
		return 0, distance
	end
	local cosA = math.clamp(camCF.LookVector:Dot(offset.Unit), -1, 1)
	return math.deg(math.acos(cosA)), distance
end

function AimController:hasLineOfSight(position, model, cam)
	if not State.requireLineOfSight then
		return true
	end

	local filter = {}
	if player.Character then
		table.insert(filter, player.Character)
	end

	local origin = cam.CFrame.Position
	local direction = position - origin

	for _ = 1, 6 do
		rayParams.FilterDescendantsInstances = filter
		local result = workspace:Raycast(origin, direction, rayParams)
		if result == nil or result.Instance:IsDescendantOf(model) then
			return true
		end
		local hit = result.Instance
		if hit.Transparency >= 0.9 or not hit.CanCollide then
			table.insert(filter, hit)
		else
			return false
		end
	end

	return false
end

function AimController:findBestTarget(cam)
	local bestModel = nil
	local bestScore = math.huge
	for _, model in ipairs(self:getCandidates()) do
		if self:isAlive(model) and self:getPlayerFromModel(model) then
			local _, position = self:getAimPartAndPos(model)
			if position then
				local angle, distance = self:getAngleAndDistance(position, cam)
				if angle <= State.fov and distance <= AIM_CONSTANTS.maxDistance and self:hasLineOfSight(position, model, cam) then
					local score = angle + (distance / AIM_CONSTANTS.maxDistance) * 3.5
					if score < bestScore then
						bestModel = model
						bestScore = score
					end
				end
			end
		end
	end
	return bestModel
end

function AimController:isStillValid(model, cam)
	if not model or not model.Parent or not self:isAlive(model) or not self:getPlayerFromModel(model) then
		return false
	end
	if State.targetPlayer and model ~= State.targetPlayer.Character then
		return false
	end
	local _, position = self:getAimPartAndPos(model)
	if not position then
		return false
	end
	local angle, distance = self:getAngleAndDistance(position, cam)
	local breakAngle = math.min(State.fov * AIM_CONSTANTS.breakMultiplier, 89)
	return angle <= breakAngle and distance <= AIM_CONSTANTS.maxDistance and self:hasLineOfSight(position, model, cam)
end

function AimController:isTouchOnFireControl(pos)
	if not self.playerGui or not self.playerGui.Parent then
		return false
	end
	local ok, guiObjects = pcall(function()
		return self.playerGui:GetGuiObjectsAtPosition(pos.X, pos.Y)
	end)
	if not ok or typeof(guiObjects) ~= "table" then
		return false
	end

	local foundInteractiveControl = false
	for _, obj in ipairs(guiObjects) do
		if self.gui and obj:IsDescendantOf(self.gui) then
			return false
		end
		if obj:IsA("GuiButton") then
			foundInteractiveControl = true
			local lowerName = string.lower(obj.Name)
			local lowerParent = obj.Parent and string.lower(obj.Parent.Name) or ""
			if string.find(lowerName, "jump")
				or string.find(lowerName, "thumbstick")
				or string.find(lowerName, "joystick")
				or string.find(lowerName, "move")
				or string.find(lowerName, "crouch")
				or string.find(lowerParent, "touchcontrol")
			then
				return false
			end
			if string.find(lowerName, "fire")
				or string.find(lowerName, "shoot")
				or string.find(lowerName, "attack")
				or string.find(lowerName, "trigger")
				or string.find(lowerParent, "fire")
				or string.find(lowerParent, "shoot")
			then
				return true
			end
		end
	end

	return foundInteractiveControl
end

function AimController:handleInputBegan(input, gameProcessed)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.KeyCode == Enum.KeyCode.ButtonR2 then
		if not (self.isInsideGuiFn and self.isInsideGuiFn(input.Position)) then
			self.firingByAttack = true
		end
	elseif input.UserInputType == Enum.UserInputType.Touch then
		if not (self.isInsideGuiFn and self.isInsideGuiFn(input.Position)) and self:isTouchOnFireControl(input.Position) then
			self.firingByAttack = true
			self.fireTouchObject = input
		end
	end
end

function AimController:handleInputEnded(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.KeyCode == Enum.KeyCode.ButtonR2 then
		self.firingByAttack = false
	elseif input.UserInputType == Enum.UserInputType.Touch then
		if self.fireTouchObject == nil or input == self.fireTouchObject then
			self.firingByAttack = false
			self.fireTouchObject = nil
		end
	end
end

function AimController:isFiringActive()
	if UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) then
		return true
	end
	if self.fireTouchObject and self.fireTouchObject.UserInputState == Enum.UserInputState.End then
		self.firingByAttack = false
		self.fireTouchObject = nil
	end
	return self.firingByAttack
end

function AimController:step(dt, cam, circleFrame, circleStroke)
	local showCircle = State.aimEnabled and State.showFov
	circleFrame.Visible = showCircle
	if showCircle then
		local halfFov = math.rad(cam.FieldOfView) * 0.5
		local tanHalf = math.max(math.tan(halfFov), 0.0001)
		local radius = (math.tan(math.rad(State.fov)) / tanHalf) * (cam.ViewportSize.Y * 0.5)
		local diameter = math.clamp(radius * 2, 16, 4000)
		circleFrame.Size = UDim2.fromOffset(diameter, diameter)
		circleStroke.Color = self.currentModel and BASE_COLORS.locked or BASE_COLORS.text
	end

	if not (State.aimEnabled and self:isFiringActive()) then
		self:resetTracking()
		return false
	end

	local now = os.clock()
	if self.currentModel then
		if self:isStillValid(self.currentModel, cam) then
			self.invalidSince = nil
		else
			if not self.invalidSince then
				self.invalidSince = now
			elseif (now - self.invalidSince) >= AIM_CONSTANTS.targetSwitchGrace then
				self:resetTracking()
			end
		end
	end

	if not self.currentModel then
		self.currentModel = self:findBestTarget(cam)
		self.invalidSince = nil
		self.lastAimPos = nil
		self.lastRawPos = nil
		self.lastVelEstimate = Vector3.zero
	end

	if self.currentModel then
		local part, rawPos = self:getAimPartAndPos(self.currentModel)
		if part and rawPos then
			local safeDt = math.clamp(dt, 0.001, 0.05)

			local instVel = part.AssemblyLinearVelocity
			if self.lastRawPos then
				local derivedVel = (rawPos - self.lastRawPos) / safeDt
				local speedDelta = (derivedVel - instVel).Magnitude
				local blend = (speedDelta > 45) and 0.65 or 0.35
				instVel = instVel:Lerp(derivedVel, blend)
			end
			self.lastRawPos = rawPos
			self.lastVelEstimate = self.lastVelEstimate:Lerp(instVel, 1 - math.exp(-20 * safeDt))

			local predictedPos = rawPos
			if State.velocityPredict then
				local distance = (rawPos - cam.CFrame.Position).Magnitude
				local leadTime = math.clamp(
					distance / AIM_CONSTANTS.projectileSpeed,
					AIM_CONSTANTS.leadTimeMin,
					AIM_CONSTANTS.leadTimeMax
				)
				predictedPos = rawPos + self.lastVelEstimate * leadTime
			end

			local camCF = cam.CFrame
			local toTarget = predictedPos - camCF.Position
			if toTarget.Magnitude > 0.01 then
				if State.smoothAim then
					local posAlpha = 1 - math.exp(-30 * safeDt)
					local smoothedTargetPos = self.lastAimPos and self.lastAimPos:Lerp(predictedPos, posAlpha) or predictedPos
					self.lastAimPos = smoothedTargetPos

					local goal = CFrame.lookAt(camCF.Position, smoothedTargetPos)
					local dirToSmoothed = (smoothedTargetPos - camCF.Position).Unit
					local angleErr = math.deg(math.acos(math.clamp(camCF.LookVector:Dot(dirToSmoothed), -1, 1)))
					local gain = math.clamp(angleErr / 4.5, 0.55, 1.45)
					local dynamicSpeed = State.smoothness * gain
					local rotAlpha = 1 - math.exp(-dynamicSpeed * safeDt)
					cam.CFrame = camCF:Lerp(goal, rotAlpha)
				else
					self.lastAimPos = predictedPos
					cam.CFrame = CFrame.lookAt(camCF.Position, predictedPos)
				end
			end
			return true
		end
	end

	return false
end

