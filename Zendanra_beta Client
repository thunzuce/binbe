local LogicController = {
	stepName = "ZendanraClientDebug_" .. HttpService:GenerateGUID(false),
	graceRemaining = 0,
	activeSubject = nil,
}

function LogicController:getRigPairs(character)
	if not character then
		return nil
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid then
		return nil
	end
	if humanoid.RigType == Enum.HumanoidRigType.R6 then
		return R6_PAIRS
	end
	return R15_PAIRS
end

function LogicController:collectWorldEntities(includeLocal)
	local list = {}
	for _, plr in ipairs(Players:GetPlayers()) do
		if includeLocal or plr ~= player then
			local char = plr.Character
			local root = char and char:FindFirstChild("HumanoidRootPart")
			local hum = char and char:FindFirstChildOfClass("Humanoid")
			if char and root and hum and hum.Health > 0 then
				table.insert(list, {
					player = plr,
					character = char,
					root = root,
					humanoid = hum,
				})
			end
		end
	end
	return list
end

function LogicController:getDisplayEntities()
	return self:collectWorldEntities(true)
end

function LogicController:getSelectableEntities()
	return self:collectWorldEntities(false)
end

function LogicController:projectWorldPoint(worldPos)
	local camera = workspace.CurrentCamera
	if not camera or typeof(worldPos) ~= "Vector3" then
		return Vector2.zero, false, 0
	end
	local viewportPos, onScreen = camera:WorldToViewportPoint(worldPos)
	local screenPos = Vector2.new(viewportPos.X, viewportPos.Y)
	local valid = onScreen and viewportPos.Z > 0
	return screenPos, valid, viewportPos.Z
end

function LogicController:updateSubjectState(dt, isSubjectValid)
	if isSubjectValid then
		self.graceRemaining = 0.25
		return true
	end
	if self.graceRemaining > 0 then
		self.graceRemaining = math.max(0, self.graceRemaining - dt)
		return true
	end
	self.activeSubject = nil
	return false
end

function LogicController:handleInputBegan(input, gameProcessed)
	if gameProcessed then
		return
	end
	if input.KeyCode == Enum.KeyCode.F4 then
		self.activeSubject = nil
		self.graceRemaining = 0
	end
end

function LogicController:bind(onTick)
	self:unbind()
	RunService:BindToRenderStep(self.stepName, Enum.RenderPriority.Camera.Value + 1, function(dt)
		if typeof(onTick) == "function" then
			safeCall("LogicControllerTick", onTick, dt, self)
		end
	end)
end

function LogicController:unbind()
	pcall(function()
		RunService:UnbindFromRenderStep(self.stepName)
	end)
end

local ResourceManager = {
	alive = true,
	connections = {},
	tweens = {},
	updaters = {},
}

function ResourceManager:connect(signal, callback, context)
	if not self.alive then return nil end
	local conn = signal:Connect(function(...)
		if self.alive then
			safeCall(context or "Signal", callback, ...)
		end
	end)
	table.insert(self.connections, conn)
	return conn
end

function ResourceManager:trackTween(tweenObj)
	if not tweenObj then return nil end
	self.tweens[tweenObj] = true
	tweenObj.Completed:Once(function()
		self.tweens[tweenObj] = nil
	end)
	return tweenObj
end

function ResourceManager:cleanup()
	if not self.alive then return end
	self.alive = false

	LogicController:unbind()

	for _, conn in ipairs(self.connections) do
		if conn.Connected then
			conn:Disconnect()
		end
	end
	table.clear(self.connections)

	for tweenObj in pairs(self.tweens) do
		pcall(function()
			tweenObj:Cancel()
		end)
		self.tweens[tweenObj] = nil
	end

	table.clear(self.updaters)
end

