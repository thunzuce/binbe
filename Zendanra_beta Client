local function safeCall(context, fn, ...)
	local ok, err = xpcall(fn, debug.traceback, ...)
	if not ok then
		warn(string.format("[Zendanra UI][%s] Lỗi: %s", tostring(context), tostring(err)))
	end
	return ok, err
end

